{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One sanitized WB feedback record",
  "type": "object",
  "required": [
    "review_id",
    "product_id",
    "text",
    "pros",
    "cons"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "group_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "rating": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "text": {
      "type": "string"
    },
    "pros": {
      "type": "string"
    },
    "cons": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
