{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified run and limitations",
  "type": "object",
  "required": [
    "run_id",
    "source_coverage",
    "analysis_status",
    "evidence_status",
    "ui_status",
    "pending_IDs",
    "execution"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_coverage": {
      "type": "object",
      "properties": {
        "article": {
          "type": "object",
          "required": [
            "expected_returned",
            "expected_text",
            "exhausted",
            "basis",
            "observed_at",
            "product_id"
          ],
          "properties": {
            "expected_returned": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "expected_text": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "exhausted": {
              "type": "boolean"
            },
            "basis": {
              "type": "string"
            },
            "observed_at": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "product_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "group": {
          "type": "object",
          "required": [
            "expected_returned",
            "expected_text",
            "exhausted",
            "basis",
            "observed_at",
            "product_ids"
          ],
          "properties": {
            "expected_returned": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "expected_text": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "exhausted": {
              "type": "boolean"
            },
            "basis": {
              "type": "string"
            },
            "observed_at": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "product_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "analysis_status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "evidence_status": {
      "enum": [
        "complete",
        "partial",
        "not_verified"
      ]
    },
    "ui_status": {
      "enum": [
        "verified",
        "not_verified",
        "not_available"
      ]
    },
    "pending_IDs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "version",
        "requested_areas"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "requested_areas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "article",
              "group"
            ]
          }
        },
        "success": {
          "type": "boolean"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stages": {
          "type": "object",
          "properties": {
            "collection": {
              "type": "object",
              "required": [
                "status",
                "reasons"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "PENDING",
                    "RUNNING",
                    "PASS",
                    "FAIL",
                    "BLOCKED"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "processing": {
              "type": "object",
              "required": [
                "status",
                "reasons"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "PENDING",
                    "RUNNING",
                    "PASS",
                    "FAIL",
                    "BLOCKED"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "evidence": {
              "type": "object",
              "required": [
                "status",
                "reasons"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "PENDING",
                    "RUNNING",
                    "PASS",
                    "FAIL",
                    "BLOCKED"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "report": {
              "type": "object",
              "required": [
                "status",
                "reasons"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "PENDING",
                    "RUNNING",
                    "PASS",
                    "FAIL",
                    "BLOCKED"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "ui": {
              "type": "object",
              "required": [
                "status",
                "reasons"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "PENDING",
                    "RUNNING",
                    "PASS",
                    "FAIL",
                    "BLOCKED"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "completion": {
              "type": "object",
              "required": [
                "status",
                "reasons"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "PENDING",
                    "RUNNING",
                    "PASS",
                    "FAIL",
                    "BLOCKED"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        "errors": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "collection",
              "processing",
              "evidence",
              "report",
              "ui"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "reason"
            ],
            "properties": {
              "status": {
                "enum": [
                  "BLOCKED",
                  "FAIL"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "ui_receipt": {
          "type": "object",
          "required": [
            "input_sha256",
            "available"
          ],
          "properties": {
            "input_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "available": {
              "type": "boolean"
            },
            "mechanism": {
              "type": "string",
              "minLength": 1
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "checks": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "status",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "BLOCKED",
                      "N/A"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "inventory": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "renderer_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "available": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "mechanism",
                  "checked_at",
                  "checks",
                  "inventory"
                ]
              },
              "else": {
                "required": [
                  "reason"
                ]
              }
            }
          ]
        }
      }
    },
    "research_status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    }
  },
  "additionalProperties": true
}
